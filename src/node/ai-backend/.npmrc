# Pi Agent's package.json declares a `prepublishOnly` script that invokes a
# Bun-based bundler. We don't need it -- the published package already contains
# a pre-built dist/ tree, and we're consuming it as a regular npm dependency.
# We also skip the package's own `postinstall` (the AI backend's
# scripts/install-ai-backend.sh uses --ignore-scripts for the same reason).
ignore-scripts=true

# Quieter install output in CI / scripted installs.
fund=false
audit=false
